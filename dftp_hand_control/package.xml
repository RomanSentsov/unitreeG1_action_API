<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>dftp_hand_control</name>
  <version>0.0.0</version>
  <description>Control package for DFTP hands implementing gestures from TZ</description>
  <maintainer email="venzoll@todo.todo">venzoll</maintainer>
  <license>TODO: License declaration</license>

  <!-- Зависимости сборки -->
  <buildtool_depend>ament_cmake</buildtool_depend>
  <build_depend>rclcpp</build_depend>
  <build_depend>service_interfaces</build_depend>

  <!-- Зависимости выполнения -->
  <exec_depend>rclcpp</exec_depend>
  <exec_depend>service_interfaces</exec_depend>

  <!-- Тестирование (можно оставить как есть) -->
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
